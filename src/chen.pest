// Chen Lang - Luau 风格语法（与 handwritten 解析器保持一致）
// 注释：-- 到行尾；换行作为空白处理

NEWLINE = _{ "\n" | "\r" }
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "--" ~ (!NEWLINE ~ ANY)* }

// --- 关键字（原子规则，避免与标识符混淆） ---
IF = @{ "if" ~ !(ASCII_ALPHANUMERIC | "_") }
THEN = @{ "then" ~ !(ASCII_ALPHANUMERIC | "_") }
ELSE = @{ "else" ~ !(ASCII_ALPHANUMERIC | "_") }
ELSEIF = @{ "elseif" ~ !(ASCII_ALPHANUMERIC | "_") }
END = @{ "end" ~ !(ASCII_ALPHANUMERIC | "_") }
LOCAL = @{ "local" ~ !(ASCII_ALPHANUMERIC | "_") }
FUNCTION = @{ "function" ~ !(ASCII_ALPHANUMERIC | "_") }
RETURN = @{ "return" ~ !(ASCII_ALPHANUMERIC | "_") }
BREAK = @{ "break" ~ !(ASCII_ALPHANUMERIC | "_") }
CONTINUE = @{ "continue" ~ !(ASCII_ALPHANUMERIC | "_") }
WHILE = @{ "while" ~ !(ASCII_ALPHANUMERIC | "_") }
DO = @{ "do" ~ !(ASCII_ALPHANUMERIC | "_") }
REPEAT = @{ "repeat" ~ !(ASCII_ALPHANUMERIC | "_") }
UNTIL = @{ "until" ~ !(ASCII_ALPHANUMERIC | "_") }
FOR = @{ "for" ~ !(ASCII_ALPHANUMERIC | "_") }
IN = @{ "in" ~ !(ASCII_ALPHANUMERIC | "_") }
AND = @{ "and" ~ !(ASCII_ALPHANUMERIC | "_") }
OR = @{ "or" ~ !(ASCII_ALPHANUMERIC | "_") }
NOT = @{ "not" ~ !(ASCII_ALPHANUMERIC | "_") }
NIL = @{ "nil" ~ !(ASCII_ALPHANUMERIC | "_") }
TRUE = @{ "true" ~ !(ASCII_ALPHANUMERIC | "_") }
FALSE = @{ "false" ~ !(ASCII_ALPHANUMERIC | "_") }
TRY = @{ "try" ~ !(ASCII_ALPHANUMERIC | "_") }
CATCH = @{ "catch" ~ !(ASCII_ALPHANUMERIC | "_") }
FINALLY = @{ "finally" ~ !(ASCII_ALPHANUMERIC | "_") }

keyword = { IF | THEN | ELSE | ELSEIF | END | LOCAL | FUNCTION | RETURN | BREAK | CONTINUE |
            WHILE | DO | REPEAT | UNTIL | FOR | IN | AND | OR | NOT | NIL | TRUE | FALSE |
            TRY | CATCH | FINALLY }

identifier = @{ !keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// --- 字面量 ---
integer = @{ ASCII_DIGIT+ }
float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
number = { float | integer }
string = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" | "'" ~ (!"'" ~ ANY)* ~ "'" }
bool = { TRUE | FALSE }
vararg = { "..." }

// --- 运算符 ---
add = { "+" }
sub = { "-" }
mul = { "*" }
div = { "/" }
floordiv = { "//" }
mod = { "%" }
pow = { "^" }
concat_op = { ".." }
len = { "#" }
eq = { "==" }
neq = { "~=" }
lt = { "<" }
lte = { "<=" }
gt = { ">" }
gte = { ">=" }
assign_op = { "+=" | "-=" | "*=" | "/=" | "//=" | "%=" | "..=" | "=" }

// --- 表达式（优先级从低到高） ---
expression = { or_expr }

or_expr = { and_expr ~ (OR ~ and_expr)* }
and_expr = { equality ~ (AND ~ equality)* }
equality = { comparison ~ ((eq | neq) ~ comparison)* }
comparison = { concat ~ ((lte | lt | gte | gt) ~ concat)* }
concat = { term ~ (concat_op ~ term)* }
term = { factor ~ ((add | sub) ~ factor)* }
factor = { unary ~ ((floordiv | mul | div | mod) ~ unary)* }
unary = { (NOT ~ unary | sub ~ unary | len ~ unary) | power }
power = { postfix ~ (pow ~ unary)? }
postfix = { primary ~ (call_suffix | dot_suffix | index_suffix | method_suffix)* }

primary = {
    number | string | bool | NIL | identifier | vararg |
    function_expr | if_stmt |
    "(" ~ expression ~ ")" |
    table_literal | array_literal
}

call_suffix = { "(" ~ argument_list? ~ ")" }
dot_suffix = { "." ~ identifier }
index_suffix = { "[" ~ expression ~ "]" }
method_suffix = { ":" ~ identifier ~ "(" ~ argument_list? ~ ")" }

argument_list = { expression ~ ("," ~ expression)* }
expression_list = { expression ~ ("," ~ expression)* }
namelist = { identifier ~ ("," ~ identifier)* }

// --- 函数定义 ---
func_body = { "(" ~ params? ~ ")" ~ block ~ END }
params = { (identifier | vararg) ~ ("," ~ (identifier | vararg))* }
function_stmt = { FUNCTION ~ identifier ~ func_body }
function_expr = { FUNCTION ~ identifier? ~ func_body }

// --- 表 / 数组字面量 ---
table_literal = { "{" ~ (field ~ ("," ~ field)* ~ ","?)? ~ "}" }
field = { (identifier ~ "=" ~ expression) | expression }
array_literal = { "[" ~ expression_list? ~ "]" }

// --- 块与语句 ---
program = { SOI ~ statement* ~ EOI }
block = { statement* }

statement = {
    local_stmt | function_stmt | while_stmt | repeat_stmt | for_stmt |
    do_stmt | return_stmt | break_stmt | continue_stmt | try_stmt |
    if_stmt | assign_multi | assign_stmt | expr_stmt
}

local_stmt = { LOCAL ~ (FUNCTION ~ identifier ~ func_body | namelist ~ ("=" ~ expression_list)?) }

while_stmt = { WHILE ~ expression ~ DO ~ block ~ END }
repeat_stmt = { REPEAT ~ block ~ UNTIL ~ expression }

for_stmt = { FOR ~ (for_numeric | for_in) }
for_numeric = { identifier ~ "=" ~ expression ~ "," ~ expression ~ ("," ~ expression)? ~ DO ~ block ~ END }
for_in = { namelist ~ IN ~ expression ~ DO ~ block ~ END }

do_stmt = { DO ~ block ~ END }
return_stmt = { RETURN ~ expression_list? }
break_stmt = { BREAK }
continue_stmt = { CONTINUE }

try_stmt = { TRY ~ block ~ CATCH ~ catch_var? ~ block ~ (FINALLY ~ block)? ~ END }
catch_var = { identifier ~ !("(") }

if_stmt = { IF ~ expression ~ THEN ~ block ~ (ELSEIF ~ expression ~ THEN ~ block)* ~ (ELSE ~ block)? ~ END }

assign_multi = { identifier ~ ("," ~ identifier)+ ~ "=" ~ expression_list }
assignable = { primary ~ (dot_suffix | index_suffix)* }
assign_stmt = { assignable ~ assign_op ~ expression }
expr_stmt = { expression }
