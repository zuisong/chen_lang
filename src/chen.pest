// 隐式规则：自动忽略空格和注释（但不包括换行）
WHITESPACE = _{ " " | "\t" | "\r" }
NEWLINE = _{ "\n" }
// 注释：// 开头直到行尾
COMMENT = _{ "//" ~ (!NEWLINE ~ ANY)* }

// 关键字
LET = @{ "let" ~ !(ASCII_ALPHANUMERIC | "_") }
FOR = @{ "for" ~ !(ASCII_ALPHANUMERIC | "_") }
FUNCTION = @{ ("function" | "def") ~ !(ASCII_ALPHANUMERIC | "_") }
RETURN = @{ "return" ~ !(ASCII_ALPHANUMERIC | "_") }
IF = @{ "if" ~ !(ASCII_ALPHANUMERIC | "_") }
ELSE = @{ "else" ~ !(ASCII_ALPHANUMERIC | "_") }
TRUE = @{ "true" ~ !(ASCII_ALPHANUMERIC | "_") }
FALSE = @{ "false" ~ !(ASCII_ALPHANUMERIC | "_") }
BREAK = @{ "break" ~ !(ASCII_ALPHANUMERIC | "_") }
CONTINUE = @{ "continue" ~ !(ASCII_ALPHANUMERIC | "_") }
TRY = @{ "try" ~ !(ASCII_ALPHANUMERIC | "_") }
CATCH = @{ "catch" ~ !(ASCII_ALPHANUMERIC | "_") }
FINALLY = @{ "finally" ~ !(ASCII_ALPHANUMERIC | "_") }
THROW = @{ "throw" ~ !(ASCII_ALPHANUMERIC | "_") }
IN = @{ "in" ~ !(ASCII_ALPHANUMERIC | "_") }
OF = @{ "of" ~ !(ASCII_ALPHANUMERIC | "_") }
WHILE = @{ "while" ~ !(ASCII_ALPHANUMERIC | "_") }
ASYNC = @{ "async" ~ !(ASCII_ALPHANUMERIC | "_") }
AWAIT = @{ "await" ~ !(ASCII_ALPHANUMERIC | "_") }
NEW = @{ "new" ~ !(ASCII_ALPHANUMERIC | "_") }

// 标识符 (不能是关键字)
identifier = @{ !keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
keyword = { LET | FOR | FUNCTION | RETURN | IF | ELSE | TRUE | FALSE | BREAK | CONTINUE | TRY | CATCH | FINALLY | THROW | IN | OF | WHILE | ASYNC | AWAIT | NEW }

// 字面量
integer = @{ "-"? ~ ASCII_DIGIT+ }
float = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
string = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" | "'" ~ (!"'" ~ ANY)* ~ "'" }
bool = { TRUE | FALSE }

// 操作符
add = { "+" }
subtract = { "-" }
multiply = { "*" }
divide = { "/" }
modulo = { "%" }
assign = { "=" }
eq = { "==" }
neq = { "!=" }
lt = { "<" }
lte = { "<=" }
gt = { ">" }
gte = { ">=" }
and = { "&&" }
or = { "||" }
not = { "!" }

// 表达式优先级处理
expression = { logical_or }

logical_or = { logical_and ~ (or ~ NEWLINE* ~ logical_and)* }
logical_and = { equality ~ (and ~ NEWLINE* ~ equality)* }
equality = { comparison ~ ((eq | neq) ~ NEWLINE* ~ comparison)* }
comparison = { term ~ ((lte | lt | gte | gt) ~ NEWLINE* ~ term)* }
term = { factor ~ ((add | subtract) ~ NEWLINE* ~ factor)* }
factor = { unary ~ ((multiply | divide | modulo) ~ NEWLINE* ~ unary)* }
unary = { ((not | subtract) ~ NEWLINE* ~ unary) | (AWAIT ~ NEWLINE* ~ unary) | primary }

primary = { atom ~ postfix* }

atom = {
    float |
    integer |
    bool |
    string |
    identifier |
    "(" ~ NEWLINE* ~ expression ~ NEWLINE* ~ ")" |
    if_expr |
    object_literal |
    block |
    async_function_def |
    function_def |
    new_expr |
    array_literal
}

postfix = { call_suffix | dot_suffix | index_suffix }
call_suffix = { "(" ~ NEWLINE* ~ arguments? ~ NEWLINE* ~ ")" }
dot_suffix = { "." ~ (identifier | keyword) }
index_suffix = { "[" ~ NEWLINE* ~ expression ~ NEWLINE* ~ "]" }

new_expr = { NEW ~ primary ~ "(" ~ NEWLINE* ~ arguments? ~ NEWLINE* ~ ")" }

object_literal = { "{" ~ NEWLINE* ~ (pair ~ ("," ~ NEWLINE* ~ pair)*)? ~ NEWLINE* ~ "}" }
array_literal = { "[" ~ NEWLINE* ~ (expression ~ ("," ~ NEWLINE* ~ expression)*)? ~ NEWLINE* ~ "]" }
pair = { (identifier | integer | string) ~ ":" ~ NEWLINE* ~ expression }

// 语句分隔符 - 使用换行
stmt_sep = _{ (NEWLINE | WHITESPACE)+ }

// 语句
statement = {
    async_declaration |
    declaration |
    for_loop |
    while_loop |
    async_function_def |
    function_def |
    return_stmt |
    break_stmt |
    continue_stmt |
    try_catch |
    throw_stmt |
    assignment |
    expression
}

declaration = { LET ~ identifier ~ (":" ~ type_expr)? ~ assign ~ NEWLINE* ~ expression }
async_declaration = { ASYNC ~ declaration }
assignment_target = { identifier ~ postfix* }
assignment = { assignment_target ~ assign ~ NEWLINE* ~ expression }

for_loop = { FOR ~ NEWLINE* ~ AWAIT? ~ NEWLINE* ~ "(" ~ NEWLINE* ~ LET ~ identifier ~ OF ~ expression ~ NEWLINE* ~ ")" ~ block }
while_loop = { WHILE ~ NEWLINE* ~ "(" ~ NEWLINE* ~ expression ~ NEWLINE* ~ ")" ~ block }
function_def = { FUNCTION ~ identifier? ~ "(" ~ NEWLINE* ~ parameters? ~ NEWLINE* ~ ")" ~ ("->" ~ type_expr)? ~ block }
async_function_def = { ASYNC ~ function_def }
return_stmt = { RETURN ~ NEWLINE* ~ expression }
break_stmt = { BREAK }
continue_stmt = { CONTINUE }
try_catch = { TRY ~ block ~ CATCH ~ ("(" ~ identifier ~ ")")? ~ block ~ (FINALLY ~ block)? }
throw_stmt = { THROW ~ NEWLINE* ~ expression }

// 类型表达式
type_expr = { type_union }
type_union = { type_primary ~ ("|" ~ type_primary)* }
type_primary = {
    "int" | "float" | "bool" | "string" | "object" | "null" |
    type_generic | identifier
}
type_generic = { identifier ~ "<" ~ type_expr ~ ("," ~ type_expr)* ~ ">" }

// 复合结构
block = { "{" ~ NEWLINE* ~ (statement ~ stmt_sep)* ~ statement? ~ NEWLINE* ~ "}" }
if_expr = { IF ~ NEWLINE* ~ "(" ~ NEWLINE* ~ expression ~ NEWLINE* ~ ")" ~ block ~ (ELSE ~ NEWLINE* ~ (if_expr | block))? }
parameters = { parameter ~ ("," ~ NEWLINE* ~ parameter)* }
parameter = { identifier ~ (":" ~ type_expr)? }
arguments = { expression ~ ("," ~ NEWLINE* ~ expression)* }

// 程序入口 - 允许语句之间有换行和空格
program = { SOI ~ (NEWLINE | WHITESPACE)* ~ (statement ~ stmt_sep)* ~ statement? ~ (NEWLINE | WHITESPACE)* ~ EOI }
